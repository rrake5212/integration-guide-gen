# Copy to .env and fill in. Never commit the filled file.
DEEPINFRA_API_KEY=your-deepinfra-token
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_PROVIDER=deepinfra
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# Fallback: OpenCode Go
# OPENCODE_API_KEY=oc_sk_...
# OPENCODE_BASE_URL=https://opencode.ai/inference/go

# Optional: FIND search fallback (residual only). No key => free rungs only.
SEARCH_PROVIDER=serper
SERPER_API_KEY=
# SEARCH_PROVIDER=brave
# BRAVE_API_KEY=
